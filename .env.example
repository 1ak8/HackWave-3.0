# ============================================================
# ⚙️ ROOT ENVIRONMENT CONFIGURATION — SELF-HEALING TESTS
# ============================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB connection string, or leave blank for auto in-memory storage)
MONGO_URI=mongodb://127.0.0.1:27017/hackwave_tests

# AI Engine Configuration
# Supported: "groq", "openai", or "local_heuristic"
AI_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=

# Automation Engine (Playwright)
# Set to false to see real Chromium browser window pop up during runs
HEADLESS_BROWSER=true
BROWSER_TIMEOUT=12000

# Frontend Configuration (Vite automatically reads VITE_ variables)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
